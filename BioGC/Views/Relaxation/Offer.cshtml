@model BioGC.Models.Product
@{
    ViewData["Title"] = "Life Resonance Spectrum Offer";
}

<style>
    .offer-header {
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.5)), url('/images/courses-bg.jpg');
        background-size: cover;
        background-position: center;
        padding: 120px 0;
        color: white;
    }

    .disclaimer {
        font-size: 0.9rem;
        color: #6c757d; /* Muted text color */
        margin-top: 1.5rem;
    }
</style>

<div class="offer-header text-center">
    <div class="container">
        <h1 class="display-4 fw-bold"
            data-ar="طيف الحياة – تجربة فريدة لتعزيز الطاقة الحيوية والتوازن العميق"
            data-en="Life Resonance Spectrum – A Unique Experience to Enhance Vital Energy and Deep Balance">
            Life Resonance Spectrum – A Unique Experience to Enhance Vital Energy and Deep Balance
        </h1>
        <p class="lead"
           data-ar="في هذه الصفحة، نقدم لك فيديوهات حصرية تعتمد على تقنية مبتكرة ومسجّلة كبراءة اختراع. كل فيديو مصمم بدقة ليحفّز خلايا الجسم والوعي، يعزز من قوة الطاقة الحيوية لديك، ويدعم الخلايا بإعادة الطاقة لها، بالإضافة إلى رفع مستوى التركيز والانسجام الداخلي."
           data-en="This page offers exclusive videos based on an innovative, patented technique. Each video is carefully designed to stimulate body cells and consciousness, enhance your vital energy, support cellular energy restoration, and improve focus and inner harmony.">
            This page offers exclusive videos based on an innovative, patented technique. Each video is carefully designed to stimulate body cells and consciousness, enhance your vital energy, support cellular energy restoration, and improve focus and inner harmony.
        </p>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <p class="fs-5"
                   data-ar="هذه التجربة تمنحك فرصة لاكتشاف مستويات جديدة من النشاط والحيوية، وتحفيز قدرات جسدك وذهنك بأسلوب متطور وفعّال."
                   data-en="This experience provides an opportunity to unlock new levels of vitality and activate your body and mind’s potential in an advanced and effective way.">
                    This experience provides an opportunity to unlock new levels of vitality and activate your body and mind’s potential in an advanced and effective way.
                </p>
                <p class="disclaimer"
                   data-ar="هذا المحتوى يهدف لتنشيط طاقاتك الداخلية وتحقيق توازن أعمق، ولا يغني عن أي علاج طبي."
                   data-en="This content is intended to activate your inner energies and achieve deeper balance, and is not a substitute for medical treatment.">
                    This content is intended to activate your inner energies and achieve deeper balance, and is not a substitute for medical treatment.
                </p>
            </div>
            <div class="col-lg-5 mt-4 mt-lg-0">
                <div class="card shadow-lg text-center p-4">
                    <div class="card-body">
                        <h3 class="card-title" data-ar="وصول دائم" data-en="Lifetime Access">Lifetime Access</h3>
                        <!-- DYNAMIC PRICE -->
                        <p class="display-5 fw-bold my-3">$@Model.PriceAfterDiscount.ToString("F2")</p>
                        <p class="text-muted" data-ar="دفعة واحدة فقط." data-en="One-time payment.">One-time payment.</p>
                        <div class="d-grid">
                            <!-- DYNAMIC PRODUCT ID -->
                            <a asp-controller="Checkout" asp-action="Service" asp-route-productId="@Model.Id" class="btn btn-primary btn-lg">
                                <span data-ar="اشترِ الآن" data-en="Buy Now">Buy Now</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
