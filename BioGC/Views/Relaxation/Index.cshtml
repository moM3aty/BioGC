@model BioGC.ViewModels.RelaxationIndexViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Relaxation Packages";
    var lang = Context.Request.Cookies["language"] ?? "en";
    var isRtl = lang == "ar";
    var pageTitle = isRtl ? "طيف الحياة – تجربة فريدة" : "Life Resonance Spectrum – A Unique Experience";
    var pageSubtitle = isRtl ? "في هذه الصفحة، نقدم لك فيديوهات حصرية تعتمد على تقنية مبتكرة ومسجّلة كبراءة اختراع. كل فيديو مصمم بدقة ليحفّز خلايا الجسم والوعي، يعزز من قوة الطاقة الحيوية لديك، ويدعم الخلايا بإعادة الطاقة لها، بالإضافة إلى رفع مستوى التركيز والانسجام الداخلي." : "This page offers exclusive videos based on an innovative, patented technique. Each video is carefully designed to stimulate body cells and consciousness, enhance your vital energy, support cellular energy restoration, and improve focus and inner harmony.";
    var purchaseBtnText = isRtl ? "اشترك الآن" : "Purchase Now";
    var viewContentBtnText = isRtl ? "تصفح الآن" : "Browse Now";
}

<style>
    :root {
        --primary-color: #2c5aa0;
        --secondary-color: #1a4480;
        --accent-color: #f0f4ff; /* Lighter blue for backgrounds */
        --text-dark: #2c3e50;
        --text-light: #6c757d;
        --border-radius: 16px; /* Slightly larger radius */
        --transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); /* Smoother transition */
        --box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        --box-shadow-hover: 0 15px 30px rgba(44,90,160,0.15);
        --success-color: #198754;
        --success-hover-color: #157347;
        --warning-color: #ffc107;
    }

    .packages-body {
        background-color: #f8fafc; /* Lighter overall background */
        font-family: 'Cairo', sans-serif;
    }

    .packages-container {
        padding: 120px 15px 60px 15px; /* More top padding */
    }

    .section-header {
        text-align: center;
        margin-bottom: 60px;
    }

        .section-header h1 {
            font-size: 3rem;
            font-weight: 800;
            color: var(--primary-color);
            margin-bottom: 15px;
        }

        .section-header p {
            font-size: 1.15rem;
            color: var(--text-light);
            max-width: 800px;
            margin: 10px auto 0;
            line-height: 1.8;
        }

    .disclaimer-box {
        background-color: var(--accent-color);
        border-left: 5px solid var(--primary-color);
        padding: 20px;
        border-radius: 0 var(--border-radius) var(--border-radius) 0;
        margin-top: 25px;
    }

    [dir="rtl"] .disclaimer-box {
        border-left: none;
        border-right: 5px solid var(--primary-color);
        border-radius: var(--border-radius) 0 0 var(--border-radius);
    }


    .category-section {
        margin-bottom: 60px;
    }

    .category-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 30px;
        position: relative;
        padding-bottom: 15px;
    }

        .category-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            border-radius: 2px;
        }

    [dir="rtl"] .category-title::after {
        left: auto;
        right: 0;
    }

    .package-card {
        background-color: #fff;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        overflow: hidden;
        transition: var(--transition);
        display: flex;
        flex-direction: column;
        height: 100%;
        border: 1px solid #e2e8f0;
    }

        .package-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--box-shadow-hover);
        }

    .package-image-wrapper {
        height: 220px;
        overflow: hidden;
    }

    .package-image {
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        transition: transform 0.4s ease;
    }

    .package-card:hover .package-image {
        transform: scale(1.1) rotate(1deg);
    }

    .package-content {
        padding: 25px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .package-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 10px;
    }

    .package-description {
        font-size: 1rem;
        color: var(--text-light);
        margin-bottom: 20px;
        flex-grow: 1;
        line-height: 1.7;
    }

    .package-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #e9ecef;
        padding-top: 20px;
        margin-top: auto;
    }

    .package-price {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--secondary-color);
    }

    .btn-purchase {
        background: var(--primary-color);
        color: #fff;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 8px;
        text-decoration: none;
        transition: var(--transition);
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 2px 8px rgba(44,90,160,0.3);
    }

        .btn-purchase:hover {
            background: var(--secondary-color);
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(44,90,160,0.4);
            color: #fff;
        }

        .btn-purchase.view-content {
            background: var(--success-color);
            box-shadow: 0 2px 8px rgba(25,135,84,0.3);
        }

            .btn-purchase.view-content:hover {
                background: var(--success-hover-color);
                box-shadow: 0 6px 12px rgba(25,135,84,0.4);
            }

        .btn-purchase.pending-approval {
            background: var(--warning-color);
            color: #333;
            cursor: not-allowed;
            box-shadow: 0 2px 8px rgba(255,193,7,0.3);
        }
</style>

<div class="packages-body">
    <div class="container packages-container" dir="@(isRtl ? "rtl" : "ltr")">
        <div class="section-header">
            <h1>@pageTitle</h1>
            <p>@pageSubtitle</p>
            <div class="disclaimer-box">
                <p class="mt-0">
                    <strong>@(isRtl ? "تجربة فريدة:" : "A Unique Experience:")</strong>
                    @(isRtl ? "هذه التجربة تمنحك فرصة لاكتشاف مستويات جديدة من النشاط والحيوية، وتحفيز قدرات جسدك وذهنك بأسلوب متطور وفعّال." : "This experience provides an opportunity to unlock new levels of vitality and activate your body and mind’s potential in an advanced and effective way.")
                </p>
                <p class="small text-muted mb-0">
                    <strong>@(isRtl ? "❖ تنويه:" : "❖ Disclaimer:")</strong>
                    @(isRtl ? "هذا المحتوى يهدف إلى تفعيل طاقاتك الداخلية وتحقيق توازن أعمق، ولا يغني عن العلاج الطبي." : "This content is intended to activate your inner energies and achieve deeper balance, and is not a substitute for medical treatment.")
                </p>
            </div>
        </div>

        @if (!Model.AllPackages.Any())
        {
            <div class="text-center">
                <p>@(isRtl ? "لا توجد باقات متاحة حاليًا." : "No packages are available at the moment.")</p>
            </div>
        }
        else
        {
            @foreach (var group in Model.AllPackages)
            {
                var category = group.Key;
                <section class="category-section">
                    <h2 class="category-title">@(isRtl? category.NameAr: category.NameEn)</h2>
                    <div class="row g-4">
                        @foreach (var package in group)
                        {
                            <div class="col-lg-4 col-md-6 d-flex">
                                <div class="package-card w-100">
                                    <div class="package-image-wrapper">
                                        <div class="package-image" style="background-image: url('/images/packages/@package.ImageUrl')"></div>
                                    </div>
                                    <div class="package-content">
                                        <h3 class="package-title">@(isRtl? package.TitleAr: package.TitleEn)</h3>
                                        <p class="package-description">@(isRtl? package.DescriptionAr: package.DescriptionEn)</p>
                                        <div class="package-footer">
                                            <span class="package-price">$@package.Price.ToString("F2")</span>

                                            @if (User.IsInRole("Admin") || Model.ApprovedPackageIds.Contains(package.Id))
                                            {
                                                <a href="@Url.Action("Details", "Relaxation", new { id = package.Id })" class="btn-purchase view-content">
                                                    <i class="fas fa-play-circle"></i> @viewContentBtnText
                                                </a>
                                            }
                                            else if (Model.PendingPackageIds.Contains(package.Id))
                                            {
                                                <button class="btn-purchase pending-approval" disabled>
                                                    <i class="fas fa-clock"></i> @(isRtl ? "قيد المراجعة" : "Pending Approval")
                                                </button>
                                            }
                                            else if (SignInManager.IsSignedIn(User))
                                            {
                                                <a href="@Url.Action("PurchasePackage", "Checkout", new { id = package.Id })" class="btn-purchase">
                                                    <i class="fas fa-shopping-cart"></i> @purchaseBtnText
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("PurchasePackage", "Checkout", new { id = package.Id }) })" class="btn-purchase">
                                                    <i class="fas fa-sign-in-alt"></i> @(isRtl ? "سجل للشراء" : "Login to Buy")
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        }
    </div>
</div>

