@model IEnumerable<BioGC.Models.RelaxationSubscription>
@{
    ViewData["Title"] = "Relaxation Subscriptions";
}

<h1 data-ar="اشتراكات خدمة الاسترخاء" data-en="Relaxation Service Subscriptions">Relaxation Service Subscriptions</h1>
<p data-ar="مراجعة طلبات الاشتراك والموافقة عليها لمنح المستخدمين حق الوصول." data-en="Review and approve subscription requests to grant users access.">Review and approve subscription requests to grant users access.</p>

<div class="card">
    <div class="card-header">
        <i class="fas fa-user-check me-1"></i>
        <span data-ar="قائمة الاشتراكات" data-en="Subscriptions List">Subscriptions List</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th data-ar="المستخدم" data-en="User">User</th>
                        <th data-ar="الباقة" data-en="Package">Package</th>
                        <th data-ar="تاريخ الاشتراك" data-en="Date">Date</th>
                        <th data-ar="حالة الدفع" data-en="Payment Status">Payment Status</th>
                        <th data-ar="حالة الاشتراك" data-en="Status">Status</th>
                        <th class="text-end" data-ar="الإجراءات" data-en="Actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4" data-ar="لا توجد اشتراكات حالياً." data-en="No subscriptions found.">No subscriptions found.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ApplicationUser.FullName <br /><small class="text-muted">@item.ApplicationUser.Email</small></td>
                            <td>@(ViewData["Language"]?.ToString() == "ar" ? item.RelaxationPackage.TitleAr : item.RelaxationPackage.TitleEn)</td>
                            <td>@item.SubscriptionDate.ToLocalTime().ToString("g")</td>
                            <td>
                                @{
                                    var paymentStatusClass = (item.Order?.OrderStatus ?? "Unknown") switch
                                    {
                                        "Awaiting Approval" => "badge-status-approved",
                                        "Pending Payment" => "badge-status-pending",
                                        "Cancelled" => "badge-status-cancelled",
                                        "Failed" => "badge-status-cancelled",
                                        _ => "badge-secondary"
                                    };
                                }
                                <span class="badge @paymentStatusClass">@(item.Order?.OrderStatus ?? "N/A")</span>
                            </td>
                            <td>
                                @{
                                    var statusClass = item.Status switch
                                    {
                                        "Approved" => "badge-status-approved",
                                        "Cancelled" => "badge-status-cancelled",
                                        _ => "badge-status-pending"
                                    };
                                }
                                <span class="badge @statusClass">@item.Status</span>
                            </td>
                            <td class="text-end">
                                @if (item.Status == "Pending Approval")
                                {
                                    <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fas fa-check me-1"></i> <span data-ar="موافقة" data-en="Approve">Approve</span>
                                        </button>
                                    </form>
                                }
                                @if (item.Status == "Approved")
                                {
                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-times me-1"></i> <span data-ar="إلغاء" data-en="Cancel">Cancel</span>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
