@model BioGC.Models.RelaxationPackage
@{
    ViewData["Title"] = "Delete Package";
}

<h1 data-ar="حذف الباقة" data-en="Delete Package">Delete Package</h1>
<hr />

<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <span data-ar="تأكيد الحذف" data-en="Confirm Deletion">Confirm Deletion</span>
    </div>
    <div class="card-body">
        <h5 class="card-title" data-ar="هل أنت متأكد أنك تريد حذف هذه الباقة؟" data-en="Are you sure you want to delete this package?">Are you sure you want to delete this package?</h5>
        <p class="text-danger" data-ar="سيتم حذف جميع الفيديوهات والصوتيات المرتبطة بهذه الباقة. لا يمكن التراجع عن هذا الإجراء." data-en="All associated videos and audios will be deleted. This action cannot be undone.">All associated videos and audios will be deleted. This action cannot be undone.</p>

        <div class="mt-4">
            <dl class="row">
                <dt class="col-sm-3" data-ar="العنوان (En)" data-en="Title (En)">Title (En)</dt>
                <dd class="col-sm-9">@Model.TitleEn</dd>
                <dt class="col-sm-3" data-ar="العنوان (Ar)" data-en="Title (Ar)">Title (Ar)</dt>
                <dd class="col-sm-9">@Model.TitleAr</dd>
                <dt class="col-sm-3" data-ar="الفئة" data-en="Category">Category</dt>
                <dd class="col-sm-9">@(Model.Category?.NameEn ?? "N/A")</dd>
            </dl>
        </div>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt me-2"></i> <span data-ar="حذف" data-en="Delete">Delete</span></button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-times me-2"></i> <span data-ar="إلغاء" data-en="Cancel">Cancel</span></a>
        </form>
    </div>
</div>
